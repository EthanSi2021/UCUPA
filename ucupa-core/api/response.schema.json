  "dependentRequired": { "sourceGraph": ["closure"], "closure": ["sourceGraph"] },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "../../shared/api/values.schema.json#/$defs/space-handle"
        },
        "boundary": {
