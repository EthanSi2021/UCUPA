              "kind": {
                "enum": [
                  "anchor",
                  "entity"
                ]
              },
              "revision": {
                "$ref": "../../shared/api/values.schema.json#/$defs/record-revision"
              },
              "address": {
                "type": "object",
                "properties": {
                  "origin": {
                    "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
                  },
                  "up": {
                    "$ref": "../../shared/api/values.schema.json#/$defs/up"
                  },
                  "down": {
                    "type": "array",
                    "items": {
                      "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
                    },
                    "maxItems": 4096,
                    "minItems": 0
                  }
                },
                "required": [
                  "down"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "element",
              "kind",
              "revision",
              "address"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "minItems": 0
        },
        "scope": {
          "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
        },
        "actualUpDepth": {
          "$ref": "../../shared/api/values.schema.json#/$defs/up"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "gap": {
          "enum": [
            "UNRESOLVED_COVERAGE",
            "EXACT_WORK_LIMIT"
          ]
        },
        "continuation": {
          "$ref": "../../shared/api/values.schema.json#/$defs/query-continuation"
        }
      },
      "required": [
        "receipt",
        "readMode",
        "matches",
        "scope",
        "actualUpDepth",
