            "anchor": {
              "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
            }
          },
          "required": [
            "core",
            "anchor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "handle",
        "boundary"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "closed": {
          "const": true
        }
      },
      "required": [
        "closed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "../../shared/api/values.schema.json#/$defs/read-receipt"
        },
        "preparation": {
          "$ref": "../../shared/api/values.schema.json#/$defs/observation-preparation"
        },
        "closure": {
          "$ref": "../../shared/api/values.schema.json#/$defs/digest",
          "not": { "const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }
        },
        "readMode": {
          "enum": [
            "CURRENT_VERIFIED",
            "RETAINED"
          ]
        },
        "sourceGraph": { "$ref": "read-source-evidence.schema.json" },
        "state": {
          "const": "NOT_FOUND"
        }
      },
      "required": [
        "receipt",
        "readMode",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "../../shared/api/values.schema.json#/$defs/read-receipt"
        },
        "preparation": {
          "$ref": "../../shared/api/values.schema.json#/$defs/observation-preparation"
        },
        "closure": {
          "$ref": "../../shared/api/values.schema.json#/$defs/digest",
          "not": { "const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }
        },
        "readMode": {
          "enum": [
            "CURRENT_VERIFIED",
            "RETAINED"
          ]
        },
        "sourceGraph": { "$ref": "read-source-evidence.schema.json" },
        "state": {
          "const": "PRESENT"
