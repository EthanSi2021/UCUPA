                  "range": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "bounded-sphere"
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "radius"
                    ],
                    "additionalProperties": false
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
                      },
                      "up": {
                        "$ref": "../../shared/api/values.schema.json#/$defs/up"
                      },
                      "down": {
                        "type": "array",
                        "items": {
                          "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
                        },
                        "maxItems": 4096,
                        "minItems": 0
                      }
                    },
                    "required": [
                      "down"
                    ],
                    "additionalProperties": false
