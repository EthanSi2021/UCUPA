                "required": [
                  "kind",
                  "element",
                  "revision",
                  "parent",
                  "pose",
                  "range",
                  "address"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 256,
          "minItems": 0
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "continuation": {
          "$ref": "../../shared/api/values.schema.json#/$defs/query-continuation"
        }
      },
      "required": [
        "receipt",
        "readMode",
        "records",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
