                  },
                  "revision": {
                    "$ref": "../../shared/api/values.schema.json#/$defs/record-revision"
                  },
                  "parent": {
                    "$ref": "../../shared/api/values.schema.json#/$defs/uuid"
                  },
                  "pose": {
                    "type": "object",
                    "properties": {
                      "translation": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 3,
                        "minItems": 3
                      },
                      "rotation": {
                        "type": "object",
