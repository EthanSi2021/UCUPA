        "record": {
          "$ref": "types.schema.json#/$defs/record"
        },
        "attachment": {
          "$ref": "types.schema.json#/$defs/attachment"
        }
      },
      "required": [
        "receipt",
        "readMode",
        "state",
        "record",
        "attachment"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "../../shared/api/values.schema.json#/$defs/read-receipt"
        },
        "preparation": {
          "$ref": "../../shared/api/values.schema.json#/$defs/observation-preparation"
        },
        "closure": {
          "$ref": "../../shared/api/values.schema.json#/$defs/digest",
          "not": { "const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" }
        },
        "readMode": {
          "enum": [
            "CURRENT_VERIFIED",
            "RETAINED"
          ]
        },
        "sourceGraph": { "$ref": "read-source-evidence.schema.json" },
        "records": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
