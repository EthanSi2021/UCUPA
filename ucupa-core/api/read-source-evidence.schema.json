{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "purpose": { "$ref": "#/$defs/stamp" },
    "operation": { "enum": ["query", "list", "read"] },
    "sources": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/source" } }
  },
  "required": ["purpose", "operation", "sources"],
  "additionalProperties": false,
  "$defs": {
    "stamp": { "$ref": "../../shared/api/values.schema.json#/$defs/digest", "not": { "const": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
    "uuid": { "$ref": "../../shared/api/values.schema.json#/$defs/uuid" },
    "parent": {
      "type": "object",
      "properties": {
        "owner": { "$ref": "#/$defs/uuid" },
        "anchor": { "$ref": "#/$defs/uuid" },
        "delegation": { "$ref": "#/$defs/stamp" },
        "acceptance": { "$ref": "#/$defs/stamp" }
      },
      "required": ["owner", "anchor", "delegation", "acceptance"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "owner": { "$ref": "#/$defs/uuid" },
        "boundary": { "$ref": "#/$defs/uuid" },
        "principal": {
          "type": "object",
          "properties": { "realm": { "type": "string", "minLength": 1 }, "principal": { "type": "string", "minLength": 1 } },
          "required": ["realm", "principal"], "additionalProperties": false
        },
        "cut": { "$ref": "#/$defs/stamp" },
        "authorization": { "$ref": "#/$defs/stamp" },
        "readMode": { "enum": ["CURRENT_VERIFIED", "RETAINED"] },
        "parent": { "$ref": "#/$defs/parent" },
        "queryScope": { "$ref": "#/$defs/uuid" },
        "coverage": { "$ref": "#/$defs/stamp" },
        "parents": { "type": "array", "maxItems": 4096, "items": {
          "type": "object", "properties": { "parent": { "$ref": "#/$defs/uuid" }, "adjacency": { "$ref": "#/$defs/stamp" } },
          "required": ["parent", "adjacency"], "additionalProperties": false
        } }
      },
      "required": ["owner", "boundary", "principal", "cut", "authorization", "readMode"],
      "dependentRequired": { "coverage": ["queryScope", "parents"], "queryScope": ["coverage"], "parents": ["coverage"] },
      "additionalProperties": false
    }
  }
}
